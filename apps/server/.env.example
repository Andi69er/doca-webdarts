# Server-Port
PORT=8787

# Erlaubte Web-Origin (Vite-Dev-Server)
CLIENT_ORIGIN=http://localhost:5173

# --- LiveKit (optional) -------------------------------------------------------
# Ohne diese drei Werte läuft die App komplett OHNE Video/Audio.
# Kostenloses Projekt anlegen: https://cloud.livekit.io  -> Settings -> Keys
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

